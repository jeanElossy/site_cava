# URL de l API backend.
VITE_API_URL=http://localhost:4000

# Espace d administration.
# "true" pour l inclure dans la build, toute autre valeur pour l exclure.
# NE PAS activer sur un deploiement public non protege.
VITE_ENABLE_ADMIN=false

# Diagnostic camera du badgeage (/presences) : panneau "Diagnostic camera"
# sous le scanner et journaux [Camera] / [Scanner] dans la console.
# "true" le temps des essais sur les telephones des agents, puis retirer
# la variable et redeployer. Toujours actif avec `npm run dev`.
VITE_CAMERA_DIAGNOSTICS=false
